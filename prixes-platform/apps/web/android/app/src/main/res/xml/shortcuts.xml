<?xml version="1.0" encoding="utf-8"?>
<!-- Long press on the Prixes icon: "Parler à Prixes" opens the app already
     listening — no screen to find, no button to touch. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://prixes.app/?voice=1"
            android:targetPackage="software.omnilink.prixes"
            android:targetClass="software.omnilink.prixes.MainActivity" />
    </shortcut>
</shortcuts>
